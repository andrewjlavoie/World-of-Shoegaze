# Copy to .env.local and fill in. .env.local is gitignored.

# MongoDB Atlas connection (server-only — never expose to the browser).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>
MONGODB_DB=wos

# Optional — for Discogs API enrichment scripts. Higher rate limit with a token.
# Register at https://www.discogs.com/settings/developers
DISCOGS_TOKEN=
