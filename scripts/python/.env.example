# Same MongoDB connection as the Next.js app. Copy to .env in this directory.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>
MONGODB_DB=wos

# Optional Discogs personal-access token. With one: 60 req/min.
# Without one: still works but slower (limited to ~25/min).
# Register at https://www.discogs.com/settings/developers
DISCOGS_TOKEN=
