# Same MongoDB connection as the Next.js app. Copy to .env in this directory.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>
MONGODB_DB=wos

# Optional Discogs personal-access token. With one: 60 req/min.
# Without one: still works but slower (limited to ~25/min).
# Register at https://www.discogs.com/settings/developers
DISCOGS_TOKEN=

# Optional Spotify client credentials (for enrich_listen_links.py).
# Create an app at https://developer.spotify.com/dashboard — no scopes required
# for client-credentials (public data only).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional Tidal Open Developer credentials (for enrich_listen_links.py).
# Register at https://developer.tidal.com/, create an app, copy Client ID + Secret.
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=
